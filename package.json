{
  "name": "skill-sync-manager",
  "productName": "Skill Sync Manager",
  "version": "0.1.0",
  "description": "Local desktop tool that manages Agent Skills and syncs a shared skill directory to Claude Code and OpenAI Codex via Windows directory junctions.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.5.0",
    "@electron-forge/maker-squirrel": "7.5.0",
    "@electron-forge/maker-zip": "7.5.0",
    "@electron-forge/plugin-vite": "7.5.0",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "31.2.0",
    "typescript": "5.4.5",
    "vite": "5.3.3",
    "vitest": "1.6.0"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "config": {
    "forge": "./forge.config.js"
  }
}
